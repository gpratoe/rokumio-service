<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ECP talks cleartext HTTP to the Roku's LAN address (arbitrary home-IP),
         and the local test requests target loopback. Both are LAN-scoped, so
         cleartext is allowed globally in this app. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>